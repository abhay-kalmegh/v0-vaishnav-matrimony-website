index 0000000..62ae83a
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,11 @@
+# Baked into the web bundle at build time (NEXT_PUBLIC_*). Rebuild after changing.
+# Copy to .env (never commit it).
+#
+# Android emulator (10.0.2.2 = the computer running Django):
+NEXT_PUBLIC_API_URL=http://10.0.2.2:8000/api
+# Physical phone on the same Wi-Fi: use the computer's LAN IP and run Django with
+#   python manage.py runserver 0.0.0.0:8000
+# NEXT_PUBLIC_API_URL=http://192.168.x.x:8000/api
+#
+# Production / store release - HTTPS only (enforced by `npm run build:android:release`):
+# NEXT_PUBLIC_API_URL=https://<your-api-domain>/api
