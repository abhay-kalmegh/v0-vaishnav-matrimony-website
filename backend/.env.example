# ---- Django (copy to backend/.env; never commit the real file) ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=False
# Comma-separated hostnames of the API. Required when DEBUG=False (no wildcard default).
ALLOWED_HOSTS=api.example.com
# Frontend/WebView origins that may call the API (Capacitor Android uses https://localhost).
CORS_ALLOWED_ORIGINS=https://localhost,https://app.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
# Serve the admin from a non-default path, e.g. manage-7f3k2/
ADMIN_URL=admin/
# Set true when running behind nginx/ALB that terminates TLS (prevents redirect loops).
BEHIND_HTTPS_PROXY=true

# ---- Database ----
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# ---- OTP / abuse limits (defaults shown) ----
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_SENDS_PER_HOUR=5
# THROTTLE_OTP_SEND=20/hour
# THROTTLE_OTP_VERIFY=60/hour

# ---- Uploads ----
# MAX_PHOTO_BYTES=5242880
# MAX_PHOTOS_PER_PROFILE=6

# ---- Celery (Redis) ----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---- SMS gateway (required before launch: OTPs are not delivered without one) ----
# SMS_API_KEY=
# SMS_SENDER_ID=
